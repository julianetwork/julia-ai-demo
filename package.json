{
  "name": "julia-ai-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Julia AI — interactive voice receptionist demo for barbershops (Retell AI web calls).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,blue \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:client": "vite",
    "build": "npm run typecheck && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check:secrets": "node scripts/check-bundle-secrets.mjs"
  },
  "dependencies": {
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "retell-client-js-sdk": "^3.0.2",
    "retell-sdk": "^6.2.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
