# ─────────────────────────────────────────────────────────────
# Julia AI demo — server-side configuration
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# Nothing in this file is ever sent to the browser.
# ─────────────────────────────────────────────────────────────

# REQUIRED. Your Retell *secret* API key (Retell dashboard → Settings → API Keys).
RETELL_API_KEY=your_retell_secret_api_key_here

# The published Retell voice agent Julia runs on.
RETELL_AGENT_ID=agent_022698413456f29efd82adef26

# Port for the Express API (and for the built app in production mode).
PORT=8787

# How many web calls one IP may start per window (basic abuse protection).
CALL_RATE_LIMIT_MAX=6
CALL_RATE_LIMIT_WINDOW_MINUTES=10

# Optional. IANA time zone used to resolve "today", "tomorrow", "Friday"… in bookings.
# Defaults to the server's local time zone.
# DEMO_TIMEZONE=America/Toronto
