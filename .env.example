# ─────────────────────────────────────────────────────────────
# Julia AI demo — server-side configuration
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# Nothing in this file is ever sent to the browser.
# ─────────────────────────────────────────────────────────────

# REQUIRED. Your Retell *secret* API key (Retell dashboard → Settings → API Keys).
RETELL_API_KEY=your_retell_secret_api_key_here

# The published Retell voice agent Julia runs on.
RETELL_AGENT_ID=agent_022698413456f29efd82adef26

# Port for the Express API (and for the built app in production mode).
PORT=8787

# How many web calls one IP may start per window (basic abuse protection).
CALL_RATE_LIMIT_MAX=6
CALL_RATE_LIMIT_WINDOW_MINUTES=10

# Optional. IANA time zone used to resolve "today", "tomorrow", "Friday"… in bookings.
# Defaults to the server's local time zone.
# DEMO_TIMEZONE=America/Toronto

# When hosted behind proxies (Render, Railway, Fly.io), set this to the number of
# proxy hops so per-IP rate limiting sees each visitor's real IP. The server logs
# the value to use ("proxy hops: ... set TRUST_PROXY=N"). Avoid `true`: visitors
# can spoof it. Leave unset when running locally.
# TRUST_PROXY=3

# Site-wide cap on new calls per window, independent of IPs (protects Retell spend).
CALL_RATE_LIMIT_GLOBAL_MAX=40

# Barbershop opening hours (shop time zone). Every appointment lasts 60 minutes,
# so the last bookable start is one hour before closing.
BUSINESS_HOURS=09:00-22:00

# Recommended. A long random string; add the same value as an
# "X-Julia-Tool-Secret" header on both Retell custom functions (see README).
# Generate one with:  openssl rand -hex 24
# Requests signed by Retell (X-Retell-Signature) are accepted either way.
RETELL_TOOL_SECRET=
